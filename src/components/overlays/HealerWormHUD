import React from 'react';
import { useGameStore } from '../../hooks/useGameStore.js';

export default function HealerWormHUD() {
    const wormHealerMode = useGameStore(s => s.wormHealerMode);
    // Optional: Connect to useHealerWormGame state via a store proxy or just let the 3D loop handle the store, 
    // but since we keep game state local to the hook in `HealerWormMode.jsx`, we may need to 
    // hoist score/length to Zustand if we want a separate React DOM HUD to read them.
    // For now, we'll keep it simple: the score is implicit, or we lift it to Zustand later.

    if (!wormHealerMode) return null;

    return (
        <div style={{
            position: 'fixed',
            top: '70px',
            left: '20px',
            color: '#a855f7',
            fontFamily: "'Courier New', monospace",
            fontSize: '18px',
            fontWeight: 'bold',
            pointerEvents: 'none',
            zIndex: 100,
            textShadow: '0 2px 4px rgba(0,0,0,0.8)'
        }}>
            <div>HEALER WORM ACTIVE</div>
            <div style={{ fontSize: '14px', color: '#fff', opacity: 0.8, marginTop: '4px' }}>
                Heal the chaotic tiles!
            </div>
        </div>
    );
}
