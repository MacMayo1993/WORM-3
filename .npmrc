# The dependency graph only resolves under npm's legacy peer-dependency
# algorithm: @react-three/drei and @react-three/postprocessing declare peer
# ranges that npm 7+ strict resolution cannot satisfy against the pinned
# three@0.159 / react@18 versions.
#
# Pinning the flag here rather than relying on everyone remembering to type
# `--legacy-peer-deps` is what makes package-lock.json reproducible: a plain
# `npm ci` (which takes no flags in most CI templates) resolved a different
# tree and failed with "Missing: json-schema-traverse@0.4.1 from lock file".
legacy-peer-deps=true

# Never silently rewrite the lockfile during an install. A drifting lockfile is
# how bundle-size and performance baselines stop being comparable between runs.
save-exact=false
